# SmartSearch AI Configuration

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME="SmartSearch AI"
SECRET_KEY=smartsearch_super_secret_jwt_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / SQLite fallback)
# Production PostgreSQL example: postgresql+asyncpg://smartuser:smartpass@localhost:5432/smartsearch_db
# For zero-config local run without Docker: sqlite+aiosqlite:///./smartsearch.db
DATABASE_URL=sqlite+aiosqlite:///./smartsearch.db

# Vector Search (Qdrant)
# Production Docker URL: http://localhost:6333
# Local embedded mode if Qdrant container is not running: :memory: or ./qdrant_storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents_collection

# Keyword Search (OpenSearch)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME=smartsearch_index

# AI / Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Web Crawler (Scrapy)
CRAWLER_MAX_PAGES_DEFAULT=50
CRAWLER_DEPTH_LIMIT_DEFAULT=2
CRAWLER_DOWNLOAD_DELAY=1.0
CRAWLER_USER_AGENT="SmartSearchBot/1.0 (+http://localhost:8000/bot)"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
